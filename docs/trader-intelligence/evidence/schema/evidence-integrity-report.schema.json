{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mogo.internal/trader-intelligence/evidence/schema/evidence-integrity-report.schema.json",
  "title": "EvidenceIntegrityReport",
  "description": "PROGRAM-006 (ADR-008). Generated by scripts/trader_intelligence/validate_evidence.py. Mirrors the existing GraphIntegrityReport/acquisition validation-report shape (one wrapper document with an embedded findings array) rather than introducing a redundant standalone IntegrityFinding entity type.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated", "integrityReportId", "generatedAt", "findings", "summary"],
  "properties": {
    "generated": { "type": "boolean", "const": true },
    "integrityReportId": { "type": "string", "pattern": "^EVIDENCE_INTEGRITY\\|\\d{8}\\|\\d{3,}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "validatorVersion": { "type": "string", "default": "1.0.0" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "severity", "findingType", "entityType", "entityId", "message", "detectedAt", "resolutionStatus"],
        "properties": {
          "findingId": { "type": "string" },
          "severity": { "type": "string", "enum": ["INFO", "WARNING", "ERROR", "FATAL"] },
          "findingType": {
            "type": "string",
            "enum": [
              "ORPHANED_EVIDENCE", "ORPHANED_LINK", "ORPHANED_CLAIM", "DUPLICATE_ID",
              "DUPLICATE_IMMUTABLE_CONTENT", "INCONSISTENT_HASH", "MALFORMED_PROVENANCE",
              "INVALID_LIFECYCLE_SEQUENCE", "CONFIDENCE_COUNT_MISMATCH", "UNRESOLVED_SUPERSESSION_CHAIN",
              "CIRCULAR_DERIVATION", "CIRCULAR_SUPERSESSION", "INVALID_CONTRADICTION_RECORD",
              "INVALID_CLAIM_SCOPE", "UNSUPPORTED_SCHEMA_VERSION", "MISSING_GRAPH_RELATIONSHIP",
              "GRAPH_REFERENCES_NONEXISTENT_EVIDENCE", "PRODUCTION_RULE_LINKAGE_WITHOUT_APPROVAL",
              "MISLABELED_SYNTHETIC_FIXTURE",
              "ORPHANED_SEGMENT", "MISSING_TRANSCRIPT_LOCATOR", "INVALID_ANNOTATION_REFERENCE",
              "MISSING_DIRECTNESS_OR_CERTAINTY", "CLAIM_CANDIDATE_WITHOUT_EVIDENCE",
              "RULE_CANDIDATE_WITHOUT_CLAIM", "RULE_CANDIDATE_INCORRECTLY_ACTIVE",
              "QUESTION_REFERENCES_NONEXISTENT_CLAIM", "REVIEW_QUEUE_REFERENCES_NONEXISTENT_ENTITY",
              "APPROVED_INTAKE_WITH_UNRESOLVED_FINDINGS", "APPROVED_SOURCE_WITH_UNRESOLVED_LICENSING",
              "TRANSCRIPT_HASH_MISMATCH", "SEGMENT_HASH_MISMATCH", "SEGMENT_SEQUENCE_GAP",
              "OVERLAPPING_SEGMENT_TIMESTAMPS", "IMPOSSIBLE_LINE_RANGE", "EXPLANATION_WITHOUT_PROVENANCE"
            ]
          },
          "entityType": { "type": "string" },
          "entityId": { "type": "string" },
          "message": { "type": "string" },
          "detectedAt": { "type": "string", "format": "date-time" },
          "resolutionStatus": { "type": "string", "enum": ["open", "acknowledged", "resolved"] },
          "resolutionNotes": { "type": ["string", "null"], "default": null },
          "metadata": { "type": "object", "additionalProperties": true, "default": {} }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["INFO", "WARNING", "ERROR", "FATAL"],
      "properties": {
        "INFO": { "type": "integer", "minimum": 0 },
        "WARNING": { "type": "integer", "minimum": 0 },
        "ERROR": { "type": "integer", "minimum": 0 },
        "FATAL": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
