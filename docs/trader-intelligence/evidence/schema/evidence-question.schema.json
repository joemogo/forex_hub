{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mogo.internal/trader-intelligence/evidence/schema/evidence-question.schema.json",
  "title": "EvidenceQuestion",
  "description": "PROGRAM-006 Phase 1B (ADR-009 sec. 12, Deliverable 13). A structured, deterministically-generated gap or ambiguity blocking full confidence in a claim or evidence chain. Deliberately named EvidenceQuestion (not UnresolvedQuestion) to avoid colliding with the pre-existing, unrelated Wave-1 UNRESOLVED_QUESTION entity (traders/*/open-questions/), which is a free-form trader-level question with a different schema. Never auto-answered.",
  "type": "object",
  "additionalProperties": false,
  "required": ["questionId", "questionType", "questionText", "priority", "reason",
    "blockingStatus", "researchStatus", "answerStatus", "schemaVersion", "createdAt"],
  "properties": {
    "questionId": { "type": "string", "pattern": "^EQ\\|\\d{8}\\|\\d{3,}$" },
    "claimId": { "type": ["string", "null"], "pattern": "^CLAIM\\|.*$", "default": null },
    "evidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^EV\\|" }, "default": [] },
    "sourceIds": { "type": "array", "items": { "type": "string", "pattern": "^EVSRC\\|" }, "default": [] },
    "questionType": { "type": "string",
      "enum": ["ambiguous_statement", "implied_requirement", "self_contradiction",
        "behavior_conflicts_with_instruction", "unclear_scope", "missing_timeframe",
        "missing_session", "missing_invalidation", "missing_stop_placement",
        "missing_target_logic", "discretionary_management", "unruled_exception",
        "example_mismatch", "insufficient_independent_support", "missing_replay_validation",
        "missing_paper_validation", "other"] },
    "questionText": { "type": "string" },
    "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "reason": { "type": "string", "description": "Why this question was raised -- traceable to the specific structural condition detected." },
    "blockingStatus": { "type": "string",
      "enum": ["non_blocking", "blocks_rule_candidate", "blocks_promotion"] },
    "researchStatus": { "type": "string",
      "enum": ["open", "researching", "answered", "deferred"], "default": "open" },
    "answerStatus": { "type": "string",
      "enum": ["unanswered", "partially_answered", "answered"], "default": "unanswered" },
    "answerEvidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^EV\\|" }, "default": [] },
    "createdAt": { "type": "string", "format": "date-time" },
    "resolvedAt": { "type": ["string", "null"], "format": "date-time", "default": null },
    "schemaVersion": { "type": "integer", "minimum": 1 }
  }
}
