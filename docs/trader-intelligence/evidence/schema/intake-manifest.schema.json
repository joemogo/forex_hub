{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mogo.internal/trader-intelligence/evidence/schema/intake-manifest.schema.json",
  "title": "IntakeManifest",
  "description": "PROGRAM-006 Phase 1B (ADR-009). Represents a source (any trader, TJR-first) before full extraction begins -- registered, validated, and tracked through a lifecycle before an EvidenceSource necessarily exists for it. Generic across future evidence producers, not TJR-specific despite TJR being the first real use.",
  "type": "object",
  "additionalProperties": false,
  "required": ["intakeId", "sourceType", "intakeStatus", "extractionStatus", "reviewStatus",
    "duplicateStatus", "registeredAt", "schemaVersion", "createdAt", "updatedAt"],
  "properties": {
    "intakeId": { "type": "string", "pattern": "^INTAKE\\|[A-Z0-9_]+\\|\\d{8}\\|\\d{3,}$" },
    "sourceId": { "type": ["string", "null"], "pattern": "^EVSRC\\|.*$", "default": null,
      "description": "Populated once/if an EvidenceSource is registered for this intake." },
    "traderId": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$", "default": null },
    "strategyFamilyId": { "type": ["string", "null"], "default": null },
    "title": { "type": ["string", "null"], "default": null },
    "sourceType": { "type": "string" },
    "canonicalReference": { "type": ["string", "null"], "default": null },
    "externalReference": { "type": ["string", "null"], "default": null },
    "repositoryPath": { "type": ["string", "null"], "default": null },
    "transcriptPath": { "type": ["string", "null"], "default": null },
    "originalMediaReference": { "type": ["string", "null"], "default": null },
    "sourceDate": { "type": ["string", "null"], "default": null },
    "acquiredAt": { "type": ["string", "null"], "format": "date-time", "default": null },
    "registeredAt": { "type": "string", "format": "date-time" },
    "language": { "type": ["string", "null"], "default": null },
    "transcriptFormat": { "type": ["string", "null"],
      "enum": ["plain_text", "timestamped_text", "structured_json", null], "default": null },
    "transcriptProvider": { "type": ["string", "null"], "default": null },
    "transcriptCompleteness": { "type": "string",
      "enum": ["unknown", "complete", "partial"], "default": "unknown" },
    "licensingStatus": { "type": "string",
      "enum": ["unknown", "owner_authored", "permitted_third_party", "restricted_third_party", "public_domain"],
      "default": "unknown" },
    "contentHash": { "type": ["string", "null"], "default": null },
    "sourceMetadata": { "type": "object", "additionalProperties": true, "default": {} },
    "expectedTopics": { "type": "array", "items": { "type": "string" }, "default": [] },
    "intakeStatus": { "type": "string",
      "enum": ["discovered", "registered", "validated", "ready_for_extraction",
        "extraction_in_progress", "extracted", "review_required", "approved", "rejected",
        "duplicate", "superseded", "blocked", "failed"] },
    "extractionStatus": { "type": "string",
      "enum": ["not_started", "in_progress", "completed", "failed"], "default": "not_started" },
    "reviewStatus": { "type": "string",
      "enum": ["not_required", "pending", "in_review", "approved", "rejected"], "default": "pending" },
    "duplicateStatus": { "type": "string",
      "enum": ["unknown", "unique", "duplicate", "possible_duplicate"], "default": "unknown" },
    "supersessionStatus": { "type": ["string", "null"],
      "enum": ["none", "supersedes_another", "superseded", null], "default": "none" },
    "supersedesIntakeId": { "type": ["string", "null"], "pattern": "^INTAKE\\|.*$", "default": null },
    "failureReason": { "type": ["string", "null"], "default": null },
    "warnings": { "type": "array", "items": { "type": "string" }, "default": [] },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
