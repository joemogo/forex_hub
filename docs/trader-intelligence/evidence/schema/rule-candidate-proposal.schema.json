{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mogo.internal/trader-intelligence/evidence/schema/rule-candidate-proposal.schema.json",
  "title": "RuleCandidateProposal",
  "description": "PROGRAM-006 Phase 1B (ADR-009 sec. 8, Deliverable 12). A non-executable proposal documenting why a set of claims might be ready for rule consideration. Distinct from the existing StrategyRule entity (ADR-008 sec. 14) -- this record never marks a rule active/validated/promoted and never itself becomes a StrategyRule; a human separately decides whether and how to act on it. status is intentionally restricted to non-execution-implying values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposalId", "originatingClaimIds", "claimType", "confidenceState",
    "proposalRationale", "status", "proposalVersion", "schemaVersion", "createdAt", "updatedAt"],
  "properties": {
    "proposalId": { "type": "string", "pattern": "^RCPROP\\|\\d{8}\\|\\d{3,}$" },
    "originatingClaimIds": { "type": "array", "minItems": 1,
      "items": { "type": "string", "pattern": "^CLAIM\\|" } },
    "evidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^EV\\|" }, "default": [] },
    "supportingSourceIds": { "type": "array", "items": { "type": "string", "pattern": "^EVSRC\\|" }, "default": [] },
    "contradictingEvidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^EV\\|" }, "default": [] },
    "claimType": { "type": "string",
      "enum": ["setup_requirement", "entry_rule", "confirmation_rule", "invalidation_rule",
        "stop_rule", "target_rule", "risk_rule", "trade_management_rule", "session_rule",
        "timeframe_rule", "failure_condition", "exception"],
      "description": "Eligible claim types for rule-candidate proposal (Deliverable 12)." },
    "confidenceState": { "type": "string" },
    "directnessDistribution": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }, "default": {} },
    "extractionCertaintyDistribution": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }, "default": {} },
    "traderId": { "type": ["string", "null"], "default": null },
    "strategyFamilyId": { "type": ["string", "null"], "default": null },
    "timeframe": { "type": ["string", "null"], "default": null },
    "session": { "type": ["string", "null"], "default": null },
    "marketCondition": { "type": ["string", "null"], "default": null },
    "symbols": { "type": "array", "items": { "type": "string" }, "default": [] },
    "unresolvedQuestionIds": { "type": "array", "items": { "type": "string", "pattern": "^EQ\\|" }, "default": [] },
    "contradictionStatus": { "type": "string",
      "enum": ["none", "open_contradiction", "resolved_contradiction"], "default": "none" },
    "replayStatus": { "type": "string",
      "enum": ["not_available", "pending", "validated", "failed"], "default": "not_available" },
    "paperTradingStatus": { "type": "string",
      "enum": ["not_available", "pending", "validated", "failed"], "default": "not_available" },
    "ownerReviewStatus": { "type": "string",
      "enum": ["not_reviewed", "pending", "approved", "rejected"], "default": "not_reviewed" },
    "proposalRationale": { "type": "string" },
    "proposalVersion": { "type": "integer", "minimum": 1, "default": 1 },
    "status": { "type": "string", "enum": ["proposed", "superseded", "withdrawn"],
      "description": "Deliberately excludes any active/validated/promoted value -- this record can never itself claim execution authority." },
    "supersedesProposalId": { "type": ["string", "null"], "pattern": "^RCPROP\\|.*$", "default": null },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
