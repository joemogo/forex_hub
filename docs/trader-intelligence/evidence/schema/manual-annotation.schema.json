{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mogo.internal/trader-intelligence/evidence/schema/manual-annotation.schema.json",
  "title": "ManualAnnotation",
  "description": "PROGRAM-006 Phase 1B (ADR-009, Deliverable 10). A researcher's or owner's structured review of one TranscriptSegment, prepared as an import package -- never a direct write to production evidence/claim records. Applying an approved annotation (evidence_registry via intake_registry.apply_annotation) is the only sanctioned path from raw transcript text to an EvidenceItem/Claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["annotationId", "intakeId", "segmentId", "exactExcerpt", "evidenceType",
    "directness", "extractionCertainty", "reviewer", "reviewStatus", "schemaVersion", "createdAt"],
  "properties": {
    "annotationId": { "type": "string", "pattern": "^ANNOT\\|INTAKE\\|.+\\|\\d{3,}$" },
    "intakeId": { "type": "string", "pattern": "^INTAKE\\|.*$" },
    "segmentId": { "type": "string", "pattern": "^TSEG\\|.*$" },
    "exactExcerpt": { "type": "string" },
    "evidenceType": { "type": "string" },
    "directness": { "type": "string" },
    "extractionCertainty": { "type": "string" },
    "evidenceQuality": { "type": "string", "default": "unknown",
      "description": "Distinct from directness/extractionCertainty (ADR-009 sec. 4/Deliverable 4) -- how strong this item is taken alone, independent of whether it is explicit or inferred." },
    "normalizedObservation": { "type": ["string", "null"], "default": null },
    "proposedClaim": { "type": ["string", "null"], "default": null },
    "claimType": { "type": ["string", "null"], "default": null },
    "relationshipType": { "type": ["string", "null"], "default": null },
    "existingClaimId": { "type": ["string", "null"], "pattern": "^CLAIM\\|.*$", "default": null,
      "description": "Set when the annotation links to an already-registered claim instead of proposing a new one." },
    "traderId": { "type": ["string", "null"], "default": null },
    "strategyFamilyId": { "type": ["string", "null"], "default": null },
    "timeframe": { "type": ["string", "null"], "default": null },
    "session": { "type": ["string", "null"], "default": null },
    "marketCondition": { "type": ["string", "null"], "default": null },
    "symbol": { "type": ["string", "null"], "default": null },
    "entryContext": { "type": ["string", "null"], "default": null },
    "exitContext": { "type": ["string", "null"], "default": null },
    "riskContext": { "type": ["string", "null"], "default": null },
    "failureContext": { "type": ["string", "null"], "default": null },
    "successContext": { "type": ["string", "null"], "default": null },
    "unresolvedQuestionText": { "type": ["string", "null"], "default": null },
    "notes": { "type": ["string", "null"], "default": null },
    "reviewer": { "type": "string" },
    "reviewStatus": { "type": "string",
      "enum": ["draft", "submitted", "approved", "rejected", "applied"], "default": "draft" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
