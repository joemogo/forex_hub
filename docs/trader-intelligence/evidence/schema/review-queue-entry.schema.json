{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mogo.internal/trader-intelligence/evidence/schema/review-queue-entry.schema.json",
  "title": "ReviewQueueEntry",
  "description": "PROGRAM-006 Phase 1B (ADR-009, Deliverable 14). A deterministically-generated pointer into one of 14 review queues. Read-only signal for a human reviewer -- resolving an entry never itself mutates the referenced entity or any production behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": ["queueEntryId", "entityType", "entityId", "queueType", "priority", "reason",
    "blockingStatus", "createdAt", "updatedAt", "reviewStatus", "schemaVersion"],
  "properties": {
    "queueEntryId": { "type": "string", "pattern": "^RQ\\|[A-Z_]+\\|\\d{8}\\|\\d{3,}$" },
    "entityType": { "type": "string",
      "enum": ["EVIDENCE_SOURCE", "EVIDENCE_ITEM", "CLAIM", "CONTRADICTION_RECORD",
        "EVIDENCE_QUESTION", "RULE_CANDIDATE_PROPOSAL", "INTAKE_MANIFEST", "TRANSCRIPT_SEGMENT"] },
    "entityId": { "type": "string" },
    "queueType": { "type": "string",
      "enum": ["low_certainty_evidence", "ambiguous_evidence", "inferred_evidence",
        "duplicate_candidates", "contradiction_candidates", "contested_claims",
        "unresolved_questions", "rule_candidates", "incomplete_transcripts",
        "unresolved_licensing", "missing_provenance", "insufficient_independent_evidence",
        "supersession_review", "extraction_failures"] },
    "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "reason": { "type": "string" },
    "blockingStatus": { "type": "string", "enum": ["non_blocking", "blocking"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "reviewStatus": { "type": "string",
      "enum": ["open", "in_review", "resolved", "dismissed"], "default": "open" },
    "reviewer": { "type": ["string", "null"], "default": null },
    "resolution": { "type": ["string", "null"], "default": null },
    "reviewAction": { "type": ["string", "null"], "default": null,
      "description": "PROGRAM-007 Phase 7A (Deliverable 7). Which of the 8 reviewer actions was applied, if any. Distinct from 'resolution' (a free-text note) -- this is the closed enum a review UI/report can group and count on. Setting this never itself mutates the entity named by entityId/entityType; see review_queues.apply_review_action().",
      "enum": ["approve_as_supported_claim", "approve_as_inferred_claim", "reject", "mark_contradictory",
        "request_more_evidence", "convert_to_research_question", "propose_hypothesis", "leave_unresolved", null] },
    "reviewNotes": { "type": ["string", "null"], "default": null },
    "metadata": { "type": "object", "additionalProperties": true, "default": {} },
    "schemaVersion": { "type": "integer", "minimum": 1 }
  }
}
