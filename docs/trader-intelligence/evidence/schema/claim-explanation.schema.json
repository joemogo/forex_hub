{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mogo.internal/trader-intelligence/evidence/schema/claim-explanation.schema.json",
  "title": "ClaimExplanation",
  "description": "PROGRAM-006 Phase 1B (ADR-009, Deliverable 2). Contract for evidence_explain.explain_claim()'s output. Computed on demand -- not itself an authoritative persisted record the way a Claim or EvidenceItem is, but versioned like one so the explanation contract can evolve without breaking consumers. Every field must be derivable from stored records; nothing here is free-form narrative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claimId", "normalizedClaim", "claimType", "claimStatus", "confidenceState",
    "confidenceScore", "evidenceCounts", "sourceCounts", "directSupportingEvidence",
    "indirectSupportingEvidence", "contradictingEvidence", "weakeningEvidence",
    "contextualEvidence", "unresolvedRelationshipEvidence", "contradictionRecords",
    "unresolvedQuestions", "missingEvidenceCategories", "candidateRuleReferences",
    "sourceProvenance", "generatedAt", "explanationSchemaVersion"],
  "properties": {
    "claimId": { "type": "string", "pattern": "^CLAIM\\|" },
    "normalizedClaim": { "type": "string" },
    "claimType": { "type": "string" },
    "subjectEntityType": { "type": ["string", "null"], "default": null },
    "subjectEntityId": { "type": ["string", "null"], "default": null },
    "traderId": { "type": ["string", "null"], "default": null },
    "strategyFamilyId": { "type": ["string", "null"], "default": null },
    "timeframe": { "type": ["string", "null"], "default": null },
    "session": { "type": ["string", "null"], "default": null },
    "marketCondition": { "type": ["string", "null"], "default": null },
    "claimStatus": { "type": "string" },
    "confidenceState": { "type": "string" },
    "confidenceScore": { "type": ["number", "null"] },
    "confidenceFactorBreakdown": { "type": "object", "additionalProperties": true, "default": {} },
    "evidenceCounts": { "type": "object", "additionalProperties": { "type": "integer" } },
    "sourceCounts": { "type": "object", "additionalProperties": { "type": "integer" } },
    "sourceIndependenceAnalysis": { "type": "object", "additionalProperties": true, "default": {} },
    "directSupportingEvidence": { "type": "array", "items": { "type": "object" } },
    "indirectSupportingEvidence": { "type": "array", "items": { "type": "object" } },
    "contradictingEvidence": { "type": "array", "items": { "type": "object" } },
    "weakeningEvidence": { "type": "array", "items": { "type": "object" } },
    "contextualEvidence": { "type": "array", "items": { "type": "object" } },
    "unresolvedRelationshipEvidence": { "type": "array", "items": { "type": "object" } },
    "contradictionRecords": { "type": "array", "items": { "type": "object" } },
    "supersessionStatus": { "type": ["string", "null"], "default": null },
    "unresolvedQuestions": { "type": "array", "items": { "type": "object" } },
    "knownScopeLimitations": { "type": "array", "items": { "type": "string" }, "default": [] },
    "missingEvidenceCategories": { "type": "array", "items": { "type": "string" } },
    "candidateRuleReferences": { "type": "array", "items": { "type": "object" } },
    "replayValidationStatus": { "type": ["string", "null"], "default": null },
    "paperTradingValidationStatus": { "type": ["string", "null"], "default": null },
    "ownerReviewStatus": { "type": ["string", "null"], "default": null },
    "sourceProvenance": { "type": "array", "items": { "type": "object" } },
    "generatedAt": { "type": "string", "format": "date-time" },
    "explanationSchemaVersion": { "type": "integer", "minimum": 1 }
  }
}
